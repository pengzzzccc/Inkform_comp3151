<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="EndPanel.uss" />
    <!-- End-of-run summary: Celeste AreaComplete-style letter-drop title (built by EndPanel into
         #TitleRow) + deaths/time read from the run's save slot on open. No dim — the end scene
         is already the run's closing shot; the outlined text carries its own readability. -->
    <ui:VisualElement name="EndPanel" class="screen">
        <ui:VisualElement class="end-center">
            <ui:VisualElement name="TitleRow" class="end-title-row" picking-mode="Ignore" />
            <ui:Label name="Lbl_Deaths" class="end-stat outline" picking-mode="Ignore" />
            <ui:Label name="Lbl_Time" class="end-stat outline" picking-mode="Ignore" />
            <ui:Button name="Btn_Back" text="CONFIRM" class="menu-item floaty outline" style="margin-top: 50px;" />
        </ui:VisualElement>
        <ui:VisualElement class="confirm-hint" picking-mode="Ignore">
            <ui:Label text="Confirm - Enter" class="corner outline" picking-mode="Ignore" />
            <ui:Label text="Back - Esc" class="corner outline" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
