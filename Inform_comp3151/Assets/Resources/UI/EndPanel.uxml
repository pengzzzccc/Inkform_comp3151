<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="EndPanel.uss" />
    <!-- End-of-run summary, overlay frame: Celeste AreaComplete-style letter-drop title (built by
         EndPanel into #TitleRow), a two-column deaths/time table read from the run's save slot
         on open, one CONFIRM. No dim — the end scene is already the run's closing shot; the
         outlined text carries its own readability. -->
    <ui:VisualElement name="EndPanel" class="screen frame frame--overlay">
        <ui:VisualElement class="frame-content">
            <ui:VisualElement name="TitleRow" class="end-title-row" picking-mode="Ignore" />
            <ui:VisualElement class="end-stat-row" picking-mode="Ignore">
                <ui:Label text="Deaths" class="end-stat-label outline" picking-mode="Ignore" />
                <ui:Label name="Lbl_Deaths" class="end-stat-value outline" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="end-stat-row" picking-mode="Ignore">
                <ui:Label text="Total time" class="end-stat-label outline" picking-mode="Ignore" />
                <ui:Label name="Lbl_Time" class="end-stat-value outline" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Button name="Btn_Back" text="CONFIRM" class="menu-item end-confirm floaty outline" />
        </ui:VisualElement>
        <ui:VisualElement class="frame-footer" picking-mode="Ignore">
            <ui:VisualElement name="PromptBar" class="prompt-bar" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
