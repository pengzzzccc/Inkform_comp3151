/* ============================================================
   Inkform UI — shared base theme.
   Loaded globally via RuntimeTheme.tss (after unity-theme://default,
   so it wins ties against the default control styles).

   Per-panel layout rules live in <Panel>.uss next to each sheet,
   referenced by that sheet's <Style src>. Class names are the API
   shared with the UXML sheets and the panel C# — do not rename.
   ============================================================ */

:root {
    --c-green:     rgb(132, 255, 84);   /* hover / focus highlight */
    --c-header:    rgb(72, 61, 139);    /* version label */
    --c-gray:      rgb(128, 128, 128);  /* big titles, subheaders */
    --c-disabled:  rgb(47, 79, 79);     /* disabled rows/buttons */
    --c-card:      rgb(252, 240, 245);  /* save postcard cream */
    --c-card-edge: rgb(35, 28, 38);
    --c-ink:       rgb(24, 20, 26);     /* text on postcards */
    --c-ink-soft:  rgb(60, 50, 66);
    --c-dim:       rgba(0, 0, 0, 0.4);  /* sheet overlay */
    --c-white:     rgb(255, 255, 255);
    --fs-title: 72px;                   /* type scale, tuned for Alibaba PuHuiTi Medium */
    --fs-begin: 56px;
    --fs-page: 52px;
    --fs-item: 36px;
    --fs-value: 28px;
    --fs-sub: 22px;
    --fs-corner: 20px;
    --float-y: -8px;                   /* hover/focus lift */

    /* Layout grid (reference 1920x1080, the panel scales by height): nothing but
       backgrounds crosses the safe margins; content columns never exceed --content-w. */
    --safe-x: 120px;
    --safe-y: 64px;
    --header-h: 150px;
    --footer-h: 56px;
    --content-w: 1100px;
    --key-h: 40px;                      /* button icons / keycaps */
    --hud-margin: 32px;                 /* gameplay HUD keeps tighter to the edges than menus */
}

/* ---- sheet skeleton ---- */

.screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.dim { background-color: var(--c-dim); }

/* ---- text ----
   Clean text, no outlines: the two outline classes stay as the text API every sheet uses, but
   carry no stroke. The weight is one notch above PuHuiTi Medium via the inherited bold style
   below — it reaches every label in the panel, the postcards and keycaps included. */

:root { -unity-font-style: bold; }

.outline { -unity-text-outline-width: 0; }
.header-outline { -unity-text-outline-width: 0; }

/* ---- selectable controls ----
   Transparent background/borders suppress the Unity default Button
   look (grey rounded fill) that comes with unity-theme://default.
   :focus sits beside :hover so gamepad/keyboard navigation is visible. */

.floaty { background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 0; }
.floaty:hover, .floaty:focus { translate: 0 var(--float-y); background-color: rgba(0, 0, 0, 0); }

/* ---- menu text ---- */

.menu-item { color: var(--c-white); font-size: var(--fs-item); -unity-text-align: middle-left; padding: 4px 12px; margin: 6px 0; }
.menu-item:hover, .menu-item:focus { color: var(--c-green); }
.menu-item:disabled { color: var(--c-disabled); }
.menu-begin { font-size: var(--fs-begin); }
.menu-title { font-size: var(--fs-title); color: var(--c-gray); -unity-text-align: middle-center; }
.corner { font-size: var(--fs-corner); color: var(--c-white); }

/* ---- screen frame: every menu sheet is header / content / footer inside the safe margins ----
   Page sheets (main menu, save slots, options) keep their title top-left; overlay sheets
   (pause, end of run) add .frame--overlay and centre everything in the content area. */

.frame {
    padding-left: var(--safe-x);
    padding-right: var(--safe-x);
    padding-top: var(--safe-y);
    padding-bottom: var(--safe-y);
    flex-direction: column;
}
.frame-header { flex-shrink: 0; height: var(--header-h); justify-content: flex-start; }
.frame-content { flex-grow: 1; flex-shrink: 1; position: relative; }
.frame-footer { flex-shrink: 0; height: var(--footer-h); flex-direction: row; align-items: flex-end; justify-content: space-between; }
.frame--overlay > .frame-content { align-items: center; justify-content: center; }

.page-kicker { font-size: var(--fs-sub); color: var(--c-gray); -unity-text-align: middle-left; letter-spacing: 4px; margin-bottom: 2px; }
.page-title { font-size: var(--fs-title); color: var(--c-gray); -unity-text-align: middle-left; }
.overlay-title { margin-bottom: 40px; }

/* Content column: centred, full width up to --content-w */
.content-column { width: 100%; max-width: var(--content-w); align-self: center; flex-grow: 1; }

/* Left-aligned menu list (main menu, options categories): text starts on the safe margin */
.menu-list { flex-direction: column; align-items: flex-start; }
.menu-list > .menu-item { -unity-text-align: middle-left; padding-left: 0; }
/* Centred list for overlays */
.overlay-list { width: 100%; max-width: 720px; flex-direction: column; align-items: center; }
.overlay-list > .menu-item { -unity-text-align: middle-center; }

.version-label { color: var(--c-header); font-size: var(--fs-corner); }

/* ---- prompt bar: device-aware [icon] label pairs, bottom right (PromptBar.cs) ---- */

.prompt-bar { flex-direction: row; align-items: center; margin-left: auto; }
.prompt { flex-direction: row; align-items: center; margin-left: 32px; }
.prompt-label { font-size: var(--fs-corner); color: var(--c-white); margin-left: 8px; }
.prompt--clickable:hover > .prompt-label { color: var(--c-green); }

/* ---- button glyphs (GlyphElements.cs): pad art, or a drawn keycap in the same style ---- */

.key-icon { -unity-background-scale-mode: scale-to-fit; margin: 0 3px; flex-shrink: 0; }   /* size set in C# from the sprite */
.key-cap {
    height: var(--key-h);
    min-width: var(--key-h);
    padding: 0 8px;
    margin: 0 3px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    background-color: rgb(28, 28, 32);
    border-radius: 6px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.85);
}
.key-cap-label { font-size: 20px; color: var(--c-white); -unity-text-align: middle-center; padding: 0; margin: 0; }
.key--small.key-cap { height: 32px; min-width: 32px; padding: 0 6px; border-radius: 5px; }
.key--small > .key-cap-label { font-size: 16px; }
