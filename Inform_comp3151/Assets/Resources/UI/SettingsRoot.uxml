<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="SettingsRoot.uss" />
    <!-- The category list the settings shell opens on. Row styles cascade from the shell. -->
    <ui:VisualElement name="RootContent" class="settings-menu">
        <ui:Button name="Btn_Audio" text="AUDIO" class="menu-item menu-begin floaty outline" />
        <ui:Button name="Btn_Video" text="VIDEO" class="menu-item floaty outline" />
        <ui:Button name="Btn_Controls" text="CONTROLS" class="menu-item floaty outline" />
        <ui:Button name="Btn_ResetAll" text="RESET ALL" class="menu-item floaty outline" />
    </ui:VisualElement>
</ui:UXML>
