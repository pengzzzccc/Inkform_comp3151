<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="SettingsRoot.uss" />
    <!-- The category list the settings shell opens on, left-aligned in the content column like
         the main menu's list. RESET ALL sits apart: it is an action, not a category. -->
    <ui:VisualElement name="RootContent" class="settings-menu menu-list">
        <ui:Button name="Btn_Audio" text="AUDIO" class="menu-item floaty outline" />
        <ui:Button name="Btn_Video" text="VIDEO" class="menu-item floaty outline" />
        <ui:Button name="Btn_Controls" text="CONTROLS" class="menu-item floaty outline" />
        <ui:Button name="Btn_ResetAll" text="RESET ALL" class="menu-item settings-reset floaty outline" />
    </ui:VisualElement>
</ui:UXML>
