<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Hud.uss" />
    <!-- Gameplay HUD. Everything picks nothing (picking-mode Ignore): the HUD must never eat a
         click meant for the world. Layout mirrors the old HudRoot prefab: FPS top right,
         timer top centre, inventory bottom right, "Saved" toast above it. Visibility of the
         whole Gameplay layer is driven by Hud.SetGameplayVisible. -->
    <ui:VisualElement name="Hud" class="screen" picking-mode="Ignore">
        <ui:VisualElement name="Gameplay" class="hud-layer" picking-mode="Ignore">
            <ui:Label name="FpsLabel" class="hud-fps outline" picking-mode="Ignore" />
            <ui:Label name="TimerLabel" text="00:00" class="hud-timer outline" picking-mode="Ignore" />
            <ui:VisualElement name="Inventory" class="hud-inventory" picking-mode="Ignore">
                <ui:Image name="InventoryIcon" class="hud-inventory-icon" picking-mode="Ignore" />
                <ui:Label name="InventoryCount" text="0/1" class="hud-inventory-count outline" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="SaveToast" text="Saved" class="hud-save-toast outline" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
