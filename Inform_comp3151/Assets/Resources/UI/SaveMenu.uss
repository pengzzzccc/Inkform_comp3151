/* Save slot selection — SAVE SLOTS header over a centred cascade of postcards. */

.save-title { position: absolute; left: 0; right: 0; top: 110px; font-size: var(--fs-item); color: var(--c-white); -unity-text-align: middle-center; }

.save-column { position: absolute; left: 0; right: 0; top: 0; bottom: 0; flex-direction: column; align-items: center; justify-content: center; }

.postcard-slot { flex-shrink: 0; width: 980px; height: 150px; margin: 14px 0; }

.postcard {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: var(--c-card);
    border-color: var(--c-card-edge);
    border-width: 3px;
    border-radius: 10px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.postcard-slot:hover > .postcard, .postcard-slot:focus > .postcard { border-color: var(--c-green); }

.card-title { font-size: var(--fs-value); color: var(--c-ink-soft); -unity-text-align: middle-center; }
.card-info { font-size: var(--fs-corner); color: var(--c-ink); -unity-text-align: middle-center; margin-top: 8px; white-space: normal; }

/* The BACK button rides the bottom-right hint row (hints are picking Ignore, the button is not). */
.confirm-hint > .menu-item { font-size: var(--fs-value); margin-left: 20px; }

/* Overwrite-hold fill; width is driven by SaveMenuPanel each tick. */
.hold-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background-color: rgba(132, 255, 84, 0.22); }
