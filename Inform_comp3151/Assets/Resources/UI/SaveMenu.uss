/* Save slot selection — three postcards in the centred content column of the page frame. */

.save-column { flex-direction: column; align-items: center; justify-content: center; }

.postcard-slot { flex-shrink: 0; width: 100%; max-width: 980px; height: 132px; margin: 12px 0; }

/* Slot + level stacked on the left, vertically centred; details pinned to the bottom-right corner */
.postcard {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: var(--c-card);
    border-color: var(--c-card-edge);
    border-width: 3px;
    border-radius: 10px;
    flex-direction: row;
    align-items: center;
    padding: 0 36px;
}

.postcard-slot:hover > .postcard, .postcard-slot:focus > .postcard { border-color: var(--c-green); }

.card-main { flex-direction: column; justify-content: center; max-width: 60%; }
.card-title { font-size: var(--fs-sub); color: var(--c-ink-soft); -unity-text-align: middle-left; letter-spacing: 2px; }
.card-level { font-size: var(--fs-value); color: var(--c-ink); -unity-text-align: middle-left; margin-top: 2px; white-space: normal; }
.card-info { position: absolute; right: 24px; bottom: 14px; max-width: 45%; font-size: var(--fs-corner); color: var(--c-ink-soft); -unity-text-align: lower-right; white-space: normal; }

/* Overwrite-hold fill; width is driven by SaveMenuPanel each tick. */
.hold-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background-color: rgba(132, 255, 84, 0.22); }
