/* End of run — letter-dropped title, deaths/time stats, one CONFIRM. */

.end-center { position: absolute; left: 0; right: 0; top: 0; bottom: 0; flex-direction: column; align-items: center; justify-content: center; }
.end-title-row { flex-direction: row; align-items: center; justify-content: center; height: 120px; margin-bottom: 30px; }
.end-stat { font-size: var(--fs-begin); color: var(--c-white); -unity-text-align: middle-center; margin: 10px 0; }
