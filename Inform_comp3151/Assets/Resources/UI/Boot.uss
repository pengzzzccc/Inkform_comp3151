/* Boot sequence: the whole sheet is the black card the logos play on. Deliberately shares
   nothing with the menu look — no panel chrome, no floaty items, no focus. Opacities are
   runtime-driven by BootPanel (UiFx.Tween); USS only lays out the geometry. */

.boot-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
}

.boot-card {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    opacity: 0;
}

.boot-logo {
    width: 640px;
    height: 360px;
    background-position: center;
    background-repeat: no-repeat;
    background-size: contain;
}

.boot-placeholder {
    display: none;
    font-size: 54px;
    color: rgb(225, 225, 225);
    -unity-text-align: middle-center;
}

.boot-title {
    font-size: 100px;
    color: rgb(255, 255, 255);
}

.boot-skip {
    position: absolute;
    right: 44px;
    bottom: 34px;
    font-size: 22px;
    color: rgb(150, 150, 150);
    opacity: 0;
}
