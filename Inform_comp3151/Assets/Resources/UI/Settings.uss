/* Settings shell — two-level. Each sub-page is its own UXML/USS/Page triple mounted into
   #Pages (the page frame's content column, at most --content-w wide, so a label and its value
   never drift apart on a wide screen); this sheet carries the shell plus the shared row styles
   that cascade into every mounted page. */

.settings-pages { position: relative; }
.settings-scroll { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }

/* Row vocabulary shared by every page (the shell's stylesheet cascades down to them).
   Sub-headers are set apart by colour and tracking, not bold: faux bold on PuHuiTi Medium smears. */

.subheader { font-size: var(--fs-sub); color: var(--c-gray); -unity-text-align: middle-left; margin: 30px 12px 8px 12px; letter-spacing: 4px; }

/* flex-shrink: 0 — the rows must never be squashed by a constrained ancestor. */
.option-row { flex-shrink: 0; flex-direction: row; height: 60px; margin: 4px 0; padding: 0 12px; align-items: center; }
.option-row .row-label { font-size: var(--fs-item); color: var(--c-white); flex-grow: 1; -unity-text-align: middle-left; }
.option-row .row-arrow { font-size: var(--fs-item); color: var(--c-white); }
.option-row .row-value { font-size: var(--fs-value); color: var(--c-white); min-width: 260px; max-width: 420px; -unity-text-align: middle-center; margin: 0 16px; }
/* Rebind rows show the bound control as button icons instead of a text value */
.option-row .row-glyphs { flex-direction: row; align-items: center; justify-content: center; min-width: 260px; margin: 0 16px; }
.option-row:hover .row-label, .option-row:focus .row-label { color: var(--c-green); }
.option-row:disabled .row-label { color: var(--c-disabled); }

.slider-row { flex-shrink: 0; flex-direction: row; height: 60px; margin: 4px 0; padding: 0 12px; align-items: center; }
.slider-row .row-label { font-size: var(--fs-item); color: var(--c-white); flex-grow: 1; -unity-text-align: middle-left; }
.slider-row .settings-slider { width: 40%; max-width: 520px; height: 40px; margin-left: 16px; }
.slider-row .row-readout { font-size: var(--fs-value); color: var(--c-white); min-width: 110px; -unity-text-align: middle-right; margin-left: 16px; }
.slider-row:hover .row-label, .slider-row.focused .row-label { color: var(--c-green); }

/* The slider's own visual: thin round track, white round knob.
   (Sizing rules — the geometry logic comes from the default theme.) */
.settings-slider .unity-base-slider__tracker { height: 8px; background-color: rgba(255, 255, 255, 0.16); border-radius: 4px; }
.settings-slider .unity-base-slider__dragger { width: 20px; height: 26px; border-radius: 10px; background-color: var(--c-white); }
.settings-slider:focus .unity-base-slider__dragger,
.settings-slider .unity-base-slider__dragger:active { background-color: var(--c-green); }
